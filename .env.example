# Скопируйте файл в .env и при необходимости измените значения.
# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/vitte
# Секретный ключ подписи сессий (в продуктивной среде обязательно заменить)
SECRET_KEY=change-me-in-production
# Адрес HTTP-сервиса 1С:Предприятие; если пусто, используется файл-эмулятор data/onec_export.json
ONEC_URL=
# Максимальный возраст кэша агрегатов в секундах (по ТЗ — 1 час)
CACHE_TTL=3600
